{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "tools/*.mjs",
      "tools/*.ts",
      "*.json",
      "*.ts",
      "!apps/*/.next",
      "!apps/*/playwright-report",
      "!apps/*/test-results",
      "!packages/*/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 88
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
