# Copy this file to .env, keep mode 0600, and fill values from a secret manager.
# POSTGRES_PASSWORD must contain only URL-safe unreserved characters: A-Z a-z 0-9 . _ ~ -
POSTGRES_PASSWORD=
CLI_CONSUMPTION_API_TOKEN=
CLI_CONSUMPTION_READ_TOKEN=
CLI_CONSUMPTION_EXPORT_TOKEN=

# Public routing values, not secrets.
COLLECTOR_DOMAIN=
ACME_EMAIL=
