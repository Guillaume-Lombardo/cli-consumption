{
  "name": "cli-consumption-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.1",
    "npm": "11.16.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:offline",
    "build:web": "npm run build -w @cli-consumption/web",
    "build:esm": "npm run build -w @cli-consumption/contracts && npm run build -w @cli-consumption/analytics && npm run build -w @cli-consumption/ui",
    "build:offline": "npm run build -w @cli-consumption/offline",
    "check:generated": "node tools/check-generated.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "smoke:esm": "node tools/smoke-esm.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build:web && playwright test -c apps/web/playwright.config.ts",
    "typecheck": "tsc --noEmit && npm run typecheck:packages && npm run typecheck:web",
    "typecheck:packages": "tsc --ignoreConfig --noEmit --strict --module ESNext --moduleResolution Bundler --target ES2024 tools/typecheck-packages.ts",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run check:generated && npm run build:esm && npm run smoke:esm"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "oxc-transform-react": "0.145.0",
    "tailwindcss": "4.3.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
